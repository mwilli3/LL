{% comment %}
  LoveLarice Wellness home section.
  Upgraded per emil-design-eng + impeccable + taste-skill principles:
    - Custom easing curves (no generic CSS easings)
    - :active scale feedback on every pressable element
    - No side-stripe borders, no identical card grids, no gradient text
    - Stagger reveals via IntersectionObserver
    - Breath-pacer microinteraction (on-brand nervous-system motif)
    - prefers-reduced-motion respected
    - Only transform / opacity / clip-path / filter animated
{% endcomment %}

{% raw %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap');

  :root {
    --cream: #f7f5f2;
    --warm-beige: #eae3dc;
    --taupe: #cbb8a9;
    --warm-brown: #a47c63;
    --gold: #c6a77d;
    --dark-brown: #4a3a32;
    --near-black: #2b2b2b;
    --white: #ffffff;

    --font-heading: 'Cormorant Garamond', Georgia, serif;
    --font-body: 'Outfit', sans-serif;

    /* Emil's recommended custom curves — built-in CSS easings are too weak */
    --ease-out-quart: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out-quint: cubic-bezier(0.77, 0, 0.175, 1);
    --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);

    /* Breathing rhythm — 4-7-8 collapsed to a 11s loop */
    --breath-in: 4s;
    --breath-hold: 7s;
    --breath-out: 8s;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    color: var(--dark-brown);
    background: var(--cream);
    line-height: 1.7;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
  }

  /* ── SCROLL PROGRESS ── */
  .scroll-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    background: transparent; z-index: 200; pointer-events: none;
  }
  .scroll-progress__bar {
    height: 100%; width: 100%; background: var(--gold);
    transform-origin: left center;
    transform: scaleX(var(--scroll, 0));
    transition: transform 80ms linear;
  }

  /* ── BREATH PACER ── on-brand microinteraction ── */
  .breath-pacer {
    position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 90;
    width: 56px; height: 56px; pointer-events: auto; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    background: rgba(247, 245, 242, 0.88);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-radius: 50%;
    box-shadow: 0 6px 24px rgba(74,58,50,0.08);
    transition: transform 200ms var(--ease-out-quart),
                box-shadow 200ms var(--ease-out-quart);
  }
  .breath-pacer:hover { box-shadow: 0 10px 32px rgba(74,58,50,0.12); }
  .breath-pacer:active { transform: scale(0.96); }
  .breath-pacer__ring {
    position: absolute; inset: 8px;
    border: 1px solid var(--warm-brown);
    border-radius: 50%; opacity: 0.5;
    animation: breathScale calc(var(--breath-in) + var(--breath-hold) + var(--breath-out)) var(--ease-in-out-quint) infinite;
  }
  .breath-pacer__dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--warm-brown);
  }
  .breath-pacer__label {
    position: absolute; right: 64px; top: 50%; transform: translateY(-50%);
    font-family: var(--font-body); font-size: 0.65rem; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--dark-brown);
    background: rgba(247, 245, 242, 0.92); padding: 0.4rem 0.7rem;
    backdrop-filter: blur(10px);
    opacity: 0; transform: translateY(-50%) translateX(6px);
    transition: opacity 180ms var(--ease-out-quart),
                transform 220ms var(--ease-out-quart);
    pointer-events: none; white-space: nowrap;
  }
  .breath-pacer:hover .breath-pacer__label {
    opacity: 1; transform: translateY(-50%) translateX(0);
  }
  @keyframes breathScale {
    0%   { transform: scale(0.85); opacity: 0.45; }
    36%  { transform: scale(1.25); opacity: 0.85; } /* inhale done */
    64%  { transform: scale(1.25); opacity: 0.85; } /* hold */
    100% { transform: scale(0.85); opacity: 0.45; } /* exhale */
  }

  /* ── NAV ── */
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0.25rem 2rem;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    background: rgba(247, 245, 242, 0.86);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(203, 184, 169, 0.3);
    transition: padding 320ms var(--ease-out-quart),
                background 320ms var(--ease-out-quart);
  }
  .nav[data-scrolled="true"] { padding: 0.1rem 2rem; background: rgba(247, 245, 242, 0.96); }
  .nav-logo { display: block; width: 360px; height: auto; overflow: hidden; flex-shrink: 0; }
  .nav-logo img { width: 100%; height: auto; display: block; }
  .nav-cta {
    position: relative; overflow: hidden;
    font-family: var(--font-body); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--cream); background: var(--dark-brown);
    padding: 0.55rem 1.25rem; border: none; cursor: pointer;
    text-decoration: none; white-space: nowrap;
    transition: transform 180ms var(--ease-out-quart),
                background 220ms var(--ease-out-quart),
                box-shadow 220ms var(--ease-out-quart);
  }
  .nav-cta::after {
    content: ''; position: absolute; inset: 0; background: var(--warm-brown);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 320ms var(--ease-out-quart);
    z-index: 0;
  }
  .nav-cta:hover::after { clip-path: inset(0 0 0 0); }
  .nav-cta span { position: relative; z-index: 1; }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(74,58,50,0.16); }
  .nav-cta:active { transform: scale(0.97); }

  /* ── HERO ── */
  .hero {
    min-height: 100vh; display: flex; flex-direction: column;
    justify-content: center; align-items: center; text-align: center;
    padding: 5rem 2rem 2.5rem; position: relative; overflow: hidden; background: var(--cream);
  }
  /* Aurora layer — two slow-drifting radial gradients on transform only */
  .hero__aurora {
    position: absolute; inset: -20%; pointer-events: none; z-index: 0;
    background:
      radial-gradient(40% 35% at 70% 20%, rgba(198,167,125,0.18) 0%, transparent 70%),
      radial-gradient(45% 40% at 20% 80%, rgba(164,124,99,0.14) 0%, transparent 70%),
      radial-gradient(35% 30% at 50% 50%, rgba(234,227,220,0.5) 0%, transparent 70%);
    will-change: transform;
    animation: auroraDrift 28s var(--ease-in-out-quint) infinite alternate;
  }
  @keyframes auroraDrift {
    from { transform: translate3d(-2%, -1%, 0) scale(1); }
    to   { transform: translate3d(2%, 2%, 0) scale(1.08); }
  }
  .hero > * { position: relative; z-index: 1; }

  .hero-eyebrow {
    font-family: var(--font-body); font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.28em; text-transform: uppercase; color: var(--warm-brown);
    margin-bottom: 2rem;
    display: inline-flex; align-items: center; gap: 0.7rem;
  }
  .hero-eyebrow::before, .hero-eyebrow::after {
    content: ''; display: inline-block; width: 28px; height: 1px; background: var(--warm-brown); opacity: 0.5;
  }
  .hero-title {
    font-family: var(--font-heading); font-size: clamp(2.8rem, 6vw, 5.4rem);
    font-weight: 300; line-height: 1.12; color: var(--near-black);
    max-width: 880px; margin-bottom: 1.8rem;
    letter-spacing: -0.01em;
  }
  .hero-title em { font-style: italic; font-weight: 400; color: var(--warm-brown); }

  /* Per-word reveal so the headline lands with rhythm, not all at once */
  .hero-title .word {
    display: inline-block; opacity: 0; transform: translateY(20px);
    transition: opacity 700ms var(--ease-out-quart),
                transform 700ms var(--ease-out-quart);
  }
  .hero-title.is-in .word { opacity: 1; transform: translateY(0); }
  .hero-title.is-in .word { transition-delay: calc(var(--i, 0) * 60ms + 80ms); }

  .hero-sub {
    font-family: var(--font-body); font-size: 1.1rem; font-weight: 300;
    color: var(--dark-brown); max-width: 540px; margin-bottom: 3rem; line-height: 1.8;
    opacity: 0; transform: translateY(16px);
    transition: opacity 700ms var(--ease-out-quart) 720ms,
                transform 700ms var(--ease-out-quart) 720ms;
  }
  .hero-title.is-in ~ .hero-sub { opacity: 1; transform: translateY(0); }

  /* Hero CTA — clip-path wipe on hover, scale on active */
  .hero-cta {
    position: relative; overflow: hidden; isolation: isolate;
    display: inline-block; font-family: var(--font-body); font-size: 0.85rem;
    font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cream); background: var(--warm-brown);
    padding: 1.15rem 3.4rem; text-decoration: none;
    opacity: 0; transform: translateY(16px);
    transition: opacity 700ms var(--ease-out-quart) 900ms,
                transform 240ms var(--ease-out-quart),
                box-shadow 240ms var(--ease-out-quart);
  }
  .hero-title.is-in ~ .hero-cta { opacity: 1; transform: translateY(0); }
  .hero-cta::before {
    content: ''; position: absolute; inset: 0; background: var(--dark-brown);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 380ms var(--ease-out-quart);
    z-index: -1;
  }
  .hero-cta:hover::before { clip-path: inset(0 0 0 0); }
  .hero-cta:hover { box-shadow: 0 10px 32px rgba(74,58,50,0.18); }
  .hero-cta:active { transform: scale(0.97); }

  .hero-scroll {
    position: absolute; bottom: 2.5rem; left: 0; right: 0;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    opacity: 0; transform: translateY(8px);
    transition: opacity 700ms var(--ease-out-quart) 1300ms,
                transform 700ms var(--ease-out-quart) 1300ms;
  }
  .hero-title.is-in ~ .hero-scroll { opacity: 1; transform: translateY(0); }
  .hero-scroll span { font-size: 0.65rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--taupe); }
  .scroll-line { width: 1px; height: 44px; background: var(--taupe); position: relative; overflow: hidden; }
  .scroll-line::after {
    content: ''; position: absolute; top: -100%; left: 0; right: 0; bottom: 0;
    background: linear-gradient(to bottom, transparent, var(--warm-brown), transparent);
    animation: scrollPulse 2.4s var(--ease-in-out-quint) infinite;
  }
  @keyframes scrollPulse { 0% { transform: translateY(0); } 100% { transform: translateY(200%); } }

  /* ── SECTION SHARED ── */
  .section { padding: 5rem 2rem; }
  .section--alt { background: var(--warm-beige) !important; }
  .section-inner { max-width: 1120px; margin: 0 auto; }
  .section-eyebrow {
    font-family: var(--font-body); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.28em; text-transform: uppercase; color: var(--warm-brown);
    margin-bottom: 1.2rem; display: inline-flex; align-items: center; gap: 0.6rem;
  }
  .section-eyebrow::before {
    content: ''; display: inline-block; width: 24px; height: 1px; background: var(--warm-brown); opacity: 0.6;
  }
  .section-title {
    font-family: var(--font-heading); font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 300; line-height: 1.18; color: var(--near-black);
    margin-bottom: 1.5rem; letter-spacing: -0.005em;
  }
  .section-title em { font-style: italic; font-weight: 400; color: var(--warm-brown); }
  .section-body { font-size: 1.05rem; font-weight: 300; line-height: 1.9; color: var(--dark-brown); max-width: 640px; }

  /* Section CTA — same wipe pattern as hero */
  .section-cta {
    position: relative; overflow: hidden; isolation: isolate;
    display: inline-block; font-family: var(--font-body); font-size: 0.85rem;
    font-weight: 500; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--cream); background: var(--warm-brown);
    padding: 1.1rem 3.2rem; text-decoration: none; white-space: nowrap;
    margin-top: 2.5rem;
    transition: transform 220ms var(--ease-out-quart),
                box-shadow 220ms var(--ease-out-quart);
  }
  .section-cta::before {
    content: ''; position: absolute; inset: 0; background: var(--dark-brown);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 380ms var(--ease-out-quart);
    z-index: -1;
  }
  .section-cta:hover::before { clip-path: inset(0 0 0 0); }
  .section-cta:hover { box-shadow: 0 10px 32px rgba(74,58,50,0.18); }
  .section-cta:active { transform: scale(0.97); }

  /* ── REVEAL UTILITY — IntersectionObserver-driven ── */
  .reveal { opacity: 0; transform: translateY(24px); }
  .reveal.is-in {
    opacity: 1; transform: translateY(0);
    transition: opacity 800ms var(--ease-out-quart),
                transform 800ms var(--ease-out-quart);
  }
  .reveal-stagger > * {
    opacity: 0; transform: translateY(20px);
  }
  .reveal-stagger.is-in > * {
    opacity: 1; transform: translateY(0);
    transition: opacity 700ms var(--ease-out-quart),
                transform 700ms var(--ease-out-quart);
  }
  .reveal-stagger.is-in > *:nth-child(1) { transition-delay: 60ms; }
  .reveal-stagger.is-in > *:nth-child(2) { transition-delay: 140ms; }
  .reveal-stagger.is-in > *:nth-child(3) { transition-delay: 220ms; }
  .reveal-stagger.is-in > *:nth-child(4) { transition-delay: 300ms; }

  /* ── TRUTH SECTION ── line-by-line cascade ── */
  .truth { text-align: center; }
  .truth .section-body { margin: 0 auto 1.5rem; text-align: center; max-width: 680px; }
  .truth-final {
    font-family: var(--font-heading); font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    color: var(--near-black); margin-top: 1.2rem;
  }
  .truth-final::before, .truth-final::after {
    content: ''; display: block; width: 32px; height: 1px;
    background: var(--gold); margin: 1.4rem auto;
  }

  /* ── ARCHETYPES ── asymmetric, not identical ── */
  .archetypes-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1.1fr;
    gap: 1.5rem; margin-top: 3.5rem;
    align-items: stretch;
  }
  .archetype-card {
    background: var(--cream);
    padding: 2.8rem 2rem 2.4rem; text-align: left;
    position: relative; overflow: hidden;
    border: 1px solid rgba(203,184,169,0.4);
    transition: transform 380ms var(--ease-out-quart),
                box-shadow 380ms var(--ease-out-quart),
                border-color 380ms var(--ease-out-quart);
  }
  /* Vary the cards individually — break the "identical grid" anti-pattern */
  .archetype-card:nth-child(2) {
    background: var(--cream); margin-top: 2rem;
    border-color: rgba(198,167,125,0.5);
  }
  .archetype-card:nth-child(1) { border-top: 3px solid #2C6E6A; }
  .archetype-card:nth-child(2) { border-top: 3px solid #5A7F3C; }
  .archetype-card:nth-child(3) { border-top: 3px solid #8B3A4A; }

  .archetype-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 50px rgba(74,58,50,0.10);
    border-color: rgba(164,124,99,0.5);
  }
  .archetype-card__number {
    position: absolute; top: 1.4rem; right: 1.6rem;
    font-family: var(--font-heading); font-size: 0.9rem;
    font-style: italic; color: var(--taupe); letter-spacing: 0.1em;
  }
  .archetype-icon {
    width: 64px; height: 64px; margin-bottom: 1.6rem;
    display: flex; align-items: center; justify-content: center;
    transition: transform 480ms var(--ease-out-quart);
  }
  .archetype-card:hover .archetype-icon { transform: scale(1.06) rotate(-1.5deg); }
  .archetype-icon img { width: 100%; height: 100%; object-fit: contain; }
  .archetype-name {
    font-family: var(--font-heading); font-size: 1.55rem; font-weight: 500;
    color: var(--near-black); margin-bottom: 0.35rem; letter-spacing: -0.005em;
  }
  .archetype-tagline {
    font-family: var(--font-body); font-size: 0.7rem; font-weight: 500;
    letter-spacing: 0.22em; text-transform: uppercase; margin-bottom: 1.3rem;
  }
  .archetype-desc { font-size: 0.97rem; font-weight: 300; line-height: 1.75; color: var(--dark-brown); }
  .archetype-card__arrow {
    margin-top: 1.6rem; display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: 0.72rem; font-weight: 500; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--warm-brown);
    transition: gap 280ms var(--ease-out-quart);
  }
  .archetype-card:hover .archetype-card__arrow { gap: 0.85rem; }
  .archetype-card__arrow svg { width: 18px; height: 8px; }

  /* ── HOW IT WORKS ── horizontal timeline rhythm ── */
  .steps-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.5rem;
    margin-top: 3.5rem; position: relative;
  }
  .steps-grid::before {
    content: ''; position: absolute; top: 28px; left: 8%; right: 8%; height: 1px;
    background: linear-gradient(to right, transparent, var(--taupe), transparent);
    z-index: 0;
  }
  .step-item { text-align: center; position: relative; z-index: 1; }
  .step-number {
    width: 56px; height: 56px; margin: 0 auto 1.2rem;
    background: var(--warm-beige); color: var(--warm-brown);
    border-radius: 50%; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-heading); font-size: 1.4rem; font-style: italic; font-weight: 400;
    box-shadow: inset 0 0 0 1px rgba(198,167,125,0.4);
    transition: transform 320ms var(--ease-out-quart),
                background 320ms var(--ease-out-quart),
                color 320ms var(--ease-out-quart);
  }
  .step-item:hover .step-number {
    transform: scale(1.06);
    background: var(--warm-brown); color: var(--cream);
  }
  .step-item h4 { font-family: var(--font-heading); font-size: 1.35rem; font-weight: 500; color: var(--near-black); margin-bottom: 0.8rem; }
  .step-item p { font-size: 0.95rem; font-weight: 300; line-height: 1.75; color: var(--dark-brown); max-width: 280px; margin: 0 auto; }

  /* ── BRAND STATEMENT ── kinetic emphasis ── */
  .brand-statement {
    text-align: center; padding: 6rem 2rem;
    background: var(--warm-brown) !important; color: var(--cream) !important;
    position: relative; overflow: hidden;
  }
  .brand-statement__bg {
    position: absolute; inset: -10%; pointer-events: none;
    background: radial-gradient(50% 40% at 50% 30%, rgba(255,255,255,0.08), transparent 70%);
    animation: auroraDrift 22s var(--ease-in-out-quint) infinite alternate;
  }
  .brand-statement-text {
    font-family: var(--font-heading); font-size: clamp(1.5rem, 3.1vw, 2.05rem);
    font-weight: 300; line-height: 1.55; color: var(--cream);
    max-width: 760px; margin: 0 auto; position: relative; z-index: 1;
  }
  .brand-statement-text strong { font-weight: 500; font-style: italic; color: var(--white); }
  .brand-statement-marks {
    font-family: var(--font-heading); font-style: italic;
    color: rgba(255,255,255,0.25); font-size: 4rem; line-height: 1;
    margin-bottom: 1rem; position: relative; z-index: 1;
  }

  /* ── BDYALIGN BRIDGE ── */
  .bridge-layout { max-width: 720px; margin: 0 auto; text-align: center; }
  .bridge-products {
    font-family: var(--font-body); font-size: 0.78rem; font-weight: 400;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--warm-brown); margin: 2.2rem 0;
    display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.1rem;
  }
  .bridge-products span { position: relative; }
  .bridge-products span + span::before {
    content: '·'; position: absolute; left: -0.7rem; color: var(--taupe);
  }
  .bridge-disclaimer {
    font-size: 0.7rem; font-weight: 300; color: var(--taupe);
    margin-top: 2.4rem; line-height: 1.6; max-width: 560px;
    margin-left: auto; margin-right: auto;
  }

  /* ── EVIDENCE ROOM ── no side stripes, use full surround + quote glyph ── */
  .evidence-teasers {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem; margin-top: 3rem;
  }
  .evidence-card {
    background: var(--cream); padding: 2.8rem 2rem 2.2rem;
    position: relative; text-align: left;
    border: 1px solid rgba(203,184,169,0.4);
    transition: transform 380ms var(--ease-out-quart),
                box-shadow 380ms var(--ease-out-quart),
                border-color 380ms var(--ease-out-quart);
  }
  .evidence-card::before {
    content: '\201C'; /* curly open quote */
    position: absolute; top: -0.4rem; left: 1.4rem;
    font-family: var(--font-heading); font-style: italic;
    font-size: 4.5rem; color: var(--gold); opacity: 0.4;
    line-height: 1; pointer-events: none;
    transition: opacity 320ms var(--ease-out-quart),
                transform 320ms var(--ease-out-quart);
  }
  .evidence-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 40px rgba(74,58,50,0.10);
    border-color: rgba(198,167,125,0.6);
  }
  .evidence-card:hover::before { opacity: 0.7; transform: translateY(-2px); }
  .evidence-card p {
    font-family: var(--font-heading); font-size: 1.18rem; font-weight: 400;
    font-style: italic; line-height: 1.55; color: var(--dark-brown);
    position: relative; z-index: 1;
  }
  .evidence-card__source {
    margin-top: 1.4rem; padding-top: 1rem;
    border-top: 1px solid rgba(203,184,169,0.4);
    font-family: var(--font-body); font-size: 0.68rem; font-weight: 500;
    letter-spacing: 0.18em; text-transform: uppercase; color: var(--warm-brown);
  }
